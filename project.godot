; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Whispering Valley"
config/description="Cozy 2D Pixel Art Farming, Life Simulation & Adventure RPG"
config/version="1.0.0"
run/main_scene="res://scenes/boot/BootScene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
GameData="*res://scripts/autoload/GameData.gd"
TimeSystem="*res://scripts/autoload/TimeSystem.gd"
WeatherSystem="*res://scripts/autoload/WeatherSystem.gd"
PlayerState="*res://scripts/autoload/PlayerState.gd"
InventorySystem="*res://scripts/autoload/InventorySystem.gd"
FarmingSystem="*res://scripts/autoload/FarmingSystem.gd"
AnimalSystem="*res://scripts/autoload/AnimalSystem.gd"
EconomySystem="*res://scripts/autoload/EconomySystem.gd"
NPCSystem="*res://scripts/autoload/NPCSystem.gd"
FishingSystem="*res://scripts/autoload/FishingSystem.gd"
MiningSystem="*res://scripts/autoload/MiningSystem.gd"
CraftingSystem="*res://scripts/autoload/CraftingSystem.gd"
BuildingSystem="*res://scripts/autoload/BuildingSystem.gd"
QuestSystem="*res://scripts/autoload/QuestSystem.gd"
WorldSystem="*res://scripts/autoload/WorldSystem.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
InputAdapter="*res://scripts/autoload/InputAdapter.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="NPC"
2d_physics/layer_4="Interactable"
2d_physics/layer_5="Enemy"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.16, 0.13, 1)
